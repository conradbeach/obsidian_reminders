<li class="flex items-start gap-3 py-3">
  <%= button_to reminder_completion_path(reminder), form_class: "shrink-0", aria: { label: "Mark “#{reminder.text}” done" },
        class: "mt-0.5 size-6 shrink-0 cursor-pointer rounded-full border-2 border-violet-300 dark:border-violet-500 hover:border-violet-600 hover:bg-violet-50 dark:hover:bg-violet-950" do %>
  <% end %>
  <% if reminder.notes %>
    <details id="<%= dom_id(reminder, :notes) %>" class="group min-w-0 flex-1" data-morph-preserve="open">
      <summary class="flex cursor-pointer list-none items-start gap-2 [&::-webkit-details-marker]:hidden">
        <%= render "reminders/summary", reminder:, overdue: local_assigns[:overdue] %>
        <svg class="mt-0.5 size-5 shrink-0 text-gray-400 group-open:text-violet-600 dark:group-open:text-violet-300"
          viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round" role="img" aria-label="Notes">
          <path d="M5 3h7l3 3v11H5zM8 9h4M8 12h4M8 15h2"/>
        </svg>
      </summary>
      <p class="mt-2 whitespace-pre-wrap rounded-md bg-gray-50 px-3 py-2 text-sm text-gray-700 dark:bg-gray-800/60 dark:text-gray-300"><%= reminder.notes %></p>
    </details>
  <% else %>
    <%= render "reminders/summary", reminder:, overdue: local_assigns[:overdue] %>
  <% end %>
</li>
