<li class="flex items-start justify-between gap-4 py-3">
  <div class="min-w-0">
    <p class="font-medium"><%= reminder.text %></p>
    <p class="text-sm text-gray-500">
      <% if reminder.remind_at %>
        <%= reminder.remind_at.strftime(local_assigns[:with_date] ? "%a, %b %-d at %-l:%M %p" : "%-l:%M %p") %> ·
      <% else %>
        Couldn't understand “<%= reminder.directive %>” ·
      <% end %>
      <%= reminder.note_name %>
    </p>
  </div>
  <%= link_to "Open", reminder.obsidian_url, class: "shrink-0 text-sm font-medium text-violet-700" %>
</li>
