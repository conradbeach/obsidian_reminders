# Secrets for Kamal. Never put raw credentials in this file; it's committed to
# the repository. Other deploy settings come from Rails credentials via
# .kamal/credentials.rb.

RAILS_MASTER_KEY=$(cat config/master.key)
TS_AUTHKEY=$(ruby -r ./.kamal/credentials -e 'print KAMAL_CREDENTIALS.dig(:tailscale, :auth_key)')
