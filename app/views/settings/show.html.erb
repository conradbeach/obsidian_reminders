<header class="mb-6">
  <%= link_to "← Reminders", root_path, class: "text-sm text-violet-700" %>
  <h1 class="mt-2 text-2xl font-bold">Settings</h1>
</header>

<% if notice %>
  <p id="notice" class="mb-6 rounded-lg bg-green-50 px-3 py-2 font-medium text-green-700"><%= notice %></p>
<% end %>

<section class="mb-6 rounded-xl bg-white p-4 shadow-sm">
  <h2 class="mb-2 font-semibold">Notifications</h2>
  <%= render "push_subscriptions/status", id: "notification-settings" %>
</section>

<section id="folders" class="rounded-xl bg-white p-4 shadow-sm">
  <h2 class="font-semibold">Folders</h2>
  <%= form_with url: note_folders_path, method: :patch do |form| %>
    <%= form.label :note_folders, "Folders in the vault whose notes are yours, one per line", class: "mt-2 block" %>
    <p class="mt-1 text-sm text-gray-500">
      Reminders in notes anywhere inside these folders, including subfolders, are yours. Folders you both list are
      shared.
    </p>
    <%= form.textarea :note_folders, value: Current.user.note_folders.join("\n"), rows: 5, placeholder: "Tabitha",
          class: "mt-3 block w-full rounded-md border border-gray-300 px-3 py-2 font-mono focus:outline-violet-600" %>
    <%= form.submit "Save", class: "btn-primary mt-4" %>
  <% end %>
</section>
