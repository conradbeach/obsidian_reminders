<header class="mb-6">
  <%= link_to "← Reminders", root_path, class: "text-sm text-violet-700 dark:text-violet-300" %>
  <h1 class="mt-2 text-2xl font-bold">Settings</h1>
</header>

<% if notice %>
  <p id="notice" class="mb-6 rounded-lg bg-green-50 dark:bg-green-950/40 px-3 py-2 font-medium text-green-700 dark:text-green-300"><%= notice %></p>
<% end %>
<% if alert %>
  <p id="alert" class="mb-6 rounded-lg bg-red-50 dark:bg-red-950/40 px-3 py-2 font-medium text-red-700 dark:text-red-300"><%= alert %></p>
<% end %>

<section id="notifications" class="mb-6 rounded-xl bg-white dark:bg-gray-900 p-4 shadow-sm">
  <h2 class="mb-2 font-semibold">Notifications</h2>
  <%= render "push_subscriptions/status", id: "notification-settings" %>
</section>

<%= form_with model: Current.user, url: settings_path, method: :patch, class: "space-y-6" do |form| %>
  <% if Current.user.errors.any? %>
    <ul id="errors" class="rounded-lg bg-red-50 dark:bg-red-950/40 px-3 py-2 font-medium text-red-700 dark:text-red-300">
      <% Current.user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <section id="folders" class="rounded-xl bg-white dark:bg-gray-900 p-4 shadow-sm">
    <h2 class="font-semibold">Folders</h2>
    <%= form.label :note_folders, "Folders in the vault whose notes are yours, one per line", class: "mt-2 block" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Reminders in notes anywhere inside these folders, including subfolders, are yours. Folders you both list are
      shared.
    </p>
    <%= form.textarea :note_folders, value: Current.user.note_folders.join("\n"), rows: 5, placeholder: "Tabitha",
          class: "input mt-3 font-mono" %>
    <%= form.label :ignored_folders, "Folders to ignore, one per line", class: "mt-4 block" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Reminders in notes anywhere inside these folders, including subfolders, aren't listed or sent to you.
    </p>
    <%= form.textarea :ignored_folders, value: Current.user.ignored_folders.join("\n"), rows: 3,
          placeholder: "Tabitha/Clippings", class: "input mt-3 font-mono" %>
  </section>

  <section id="overdue" class="rounded-xl bg-white dark:bg-gray-900 p-4 shadow-sm">
    <h2 class="font-semibold">Overdue</h2>
    <%= form.label :overdue_after_hours, "Hours after its time that a reminder becomes overdue", class: "mt-2 block" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Until then, it stays listed on its day.
    </p>
    <%= form.number_field :overdue_after_hours, min: 0, step: 1, class: "input mt-3 w-24" %>
  </section>

  <section id="new-reminders" class="rounded-xl bg-white dark:bg-gray-900 p-4 shadow-sm">
    <h2 class="font-semibold">New reminders</h2>
    <%= form.label :reminders_note, "Note that reminders added in the app go in", class: "mt-2 block" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      A path from the vault's root, in one of your folders. Each reminder is added to the end of the note as a task.
    </p>
    <%= form.text_field :reminders_note, placeholder: "Tabitha/Reminders.md", class: "input mt-3 font-mono" %>
  </section>

  <%= form.submit "Save", class: "btn-primary" %>
<% end %>

<section id="api-token" class="mt-6 rounded-xl bg-white dark:bg-gray-900 p-4 shadow-sm">
  <h2 class="font-semibold">API token</h2>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    Lets other apps, like the Omarchy bar widget, read, add, and complete your reminders. Replacing it signs them out.
  </p>
  <% if Current.user.api_token %>
    <%= label_tag :api_token, "Your API token", class: "sr-only" %>
    <%= text_field_tag :api_token, Current.user.api_token, readonly: true, class: "input mt-3 font-mono text-sm" %>
  <% end %>
  <%= button_to Current.user.api_token ? "Replace token" : "Create token", api_token_path,
        class: "btn-secondary mt-3", form: { data: { turbo_confirm: (Current.user.api_token && "Replace your API token? Apps using it will stop working.") } } %>
</section>
