<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reminders" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#7953d4">
    <%= render "pwa/head" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-violet-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100">
    <main class="mx-auto max-w-2xl px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
